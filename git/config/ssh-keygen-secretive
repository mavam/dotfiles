#!/usr/bin/env bash
set -euo pipefail

# Git uses this program for SSH commit signing. Secretive can intermittently
# lose communication with its agent after idle/sleep, and concurrent signing
# requests can be rejected with "agent refused operation". This wrapper exists
# to keep signed commits reliable without ever falling back to an unsigned
# commit: it serializes Secretive signing requests, restarts a broken agent only
# after a known transient error, and retries the exact signing operation once.
# All other ssh-keygen operations, platforms, and agents pass through unchanged.
#
# Upstream tracking:
#   Git signing loses agent communication:
#     https://github.com/maxgoedjen/secretive/issues/577
#   Concurrent requests are refused:
#     https://github.com/maxgoedjen/secretive/issues/532
#   macOS 26 agent lifecycle/refusal failures:
#     https://github.com/maxgoedjen/secretive/issues/787

find_ssh_keygen() {
  command -v ssh-keygen 2>/dev/null || true
}

is_git_signing_request() {
  local previous=''
  local argument

  for argument in "$@"; do
    if [ "$previous" = '-Y' ] && [ "$argument" = 'sign' ]; then
      return 0
    fi
    previous="$argument"
  done
  return 1
}

is_secretive_agent() {
  [ "$(uname -s)" = 'Darwin' ] || return 1

  case "${SSH_AUTH_SOCK:-}" in
    */Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

restart_secretive_agent() {
  local service="gui/$(id -u)/com.maxgoedjen.Secretive.SecretAgent"

  if ! /bin/launchctl kickstart -k "$service" >/dev/null 2>&1; then
    /usr/bin/killall com.maxgoedjen.Secretive.SecretAgent >/dev/null 2>&1 || true
  fi
}

wait_for_secretive_agent() {
  local attempt=0

  while [ "$attempt" -lt 40 ]; do
    if [ -S "$SSH_AUTH_SOCK" ] \
      && SSH_AUTH_SOCK="$SSH_AUTH_SOCK" /usr/bin/ssh-add -l >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
    attempt=$((attempt + 1))
  done
  return 1
}

ssh_keygen="$(find_ssh_keygen)"
if [ -z "$ssh_keygen" ]; then
  printf 'error: ssh-keygen is not available\n' >&2
  exit 127
fi

if ! is_git_signing_request "$@" || ! is_secretive_agent; then
  exec "$ssh_keygen" "$@"
fi

# Secretive currently mishandles concurrent signing requests. Re-enter this
# script under a macOS advisory lock so only one request reaches the agent at a
# time. The environment marker prevents recursive lock acquisition.
if [ "${SECRETIVE_SIGNING_LOCKED:-0}" != '1' ]; then
  lock_file="${TMPDIR:-/tmp}/secretive-git-signing-$(id -u).lock"
  export SECRETIVE_SIGNING_LOCKED=1
  exec /usr/bin/lockf -k -t 60 "$lock_file" "$0" "$@"
fi

error_file="$(mktemp "${TMPDIR:-/tmp}/secretive-git-signing.XXXXXX")"
trap 'rm -f "$error_file"' EXIT

status=0
"$ssh_keygen" "$@" 2>"$error_file" || status=$?
if [ "$status" -eq 0 ]; then
  cat "$error_file" >&2
  exit 0
fi

if ! grep -Eiq 'agent refused operation|communication with agent failed' "$error_file"; then
  cat "$error_file" >&2
  exit "$status"
fi

printf 'warning: Secretive signing failed transiently; restarting its agent and retrying once\n' >&2
restart_secretive_agent
if ! wait_for_secretive_agent; then
  cat "$error_file" >&2
  printf 'error: Secretive agent did not become ready after restart\n' >&2
  exit "$status"
fi

# A failed ssh-keygen signing attempt may leave a partial signature beside the
# input file. Git passes exactly one input file as the final argument.
if [ "$#" -gt 0 ]; then
  input_file="${!#}"
  if [ "$input_file" != '-' ]; then
    rm -f -- "${input_file}.sig"
  fi
fi

: >"$error_file"
retry_status=0
"$ssh_keygen" "$@" 2>"$error_file" || retry_status=$?
cat "$error_file" >&2
exit "$retry_status"
